# === Core Telegram ===
# Either export BOT_TOKEN directly or point at a file.
# BOT_TOKEN=
BOT_TOKEN_FILE=/run/secrets/bot_token
BOT_USERNAME=commodore_lev_bot
# Directly addressed UTF-8 Markdown/text documents are downloaded through the
# Bot API and sent to the read-only Q&A worker. Default 131072; hard cap 262144.
# TELEGRAM_TEXT_DOCUMENT_MAX_BYTES=131072

# === Channel / topic IDs ===
# Prefix forum channels with -100.
BOT_HQ_GROUP_ID=
SQUID_CAVE_GROUP_ID=
AGENT_CHAT_GROUP_ID=-1003675648747
LEV_DEV_GROUP_ID=
ATLAS_GROUP_ID=
LEV_SEC_GROUP_ID=-5363468256

# Agent Chat forum topic overrides (defaults mirror squid-bot
# leviathan/settings.py::AGENT_CHAT_TOPICS).
# AGENT_CHAT_TOPIC_START_HERE=154
# AGENT_CHAT_TOPIC_MONETIZATION=155
# AGENT_CHAT_TOPIC_SANDBOX=156
# AGENT_CHAT_TOPIC_OPSEC=157
# AGENT_CHAT_TOPIC_API_HELP=158
# AGENT_CHAT_TOPIC_HUMAN_LOUNGE=159
# AGENT_CHAT_TOPIC_AFFILIATE=1709

# === Authorization ===
# Telegram user_ids authorized to order draft PR filing.
# CurveCap (1234982301) is the default operator; extend as needed.
ADMIN_TELEGRAM_IDS=1234982301
# Pinned direct DM destination for outages and unclassified room membership.
# Do not rely on an arbitrary member of ADMIN_TELEGRAM_IDS.
OPERATOR_DM_USER_ID=

# === Immutable-release service state ===
# Keep mutable ledgers, logs, and runtime configuration outside a release
# worktree. The Mini cron/watchdog passes FLEET_COMMODORE_CONFIG explicitly.
# FLEET_COMMODORE_STATE_DIR=~/.local/state/fleet-commodore
# COMMODORE_DB_FILE=~/.local/state/fleet-commodore/commodore.db

# === Leviathan News API (Mode B relay receipt) ===
LN_API_BASE=https://api.leviathannews.xyz/api/v1
LN_API_TOKEN=

# === LLM provider ===
# CLAUDE_BIN=  # auto-detected
# CODEX_BIN=   # auto-detected
CODEX_MODEL=gpt-5.4
CLAUDE_LIMIT_COOLDOWN=21600

# === Security-triage control plane ===
# Leave this at 0 until the operator has separately approved live Lev Sec posts.
TRIAGE_POSTING_ENABLED=0
# Leave this at 0. It gates the local, operator-confirmed inspection and
# terminal reconciliation of an ambiguous Telegram send; it never enables posts.
TRIAGE_OPERATOR_RECONCILE_ENABLED=0
# Optional: path to the Mini's read-only security_triage_feed wrapper.
# SEC_FEED_BIN=/Users/gerrithall/bin/sec_feed
# Service-owned path outside a release worktree. Preserve this SQLite ledger
# across a promotion or rollback; it contains triage send fences and receipts.
# TRIAGE_DB_FILE=~/.local/state/fleet-commodore/triage/triage.db
# TRIAGE_OPERATOR_DM_USER_ID=  # defaults to OPERATOR_DM_USER_ID when set
# TRIAGE_OPERATOR_ALERT_COOLDOWN_S=900
# The worker rejects a lease shorter than its bounded evidence/model/receipt
# envelope.  Leave unset for the conservative computed default.
# TRIAGE_CLAIM_LEASE_S=

# === GitHub identity ===
# Path to PAT file for leviathan-commodore GitHub user.
GH_PAT_FILE=/run/secrets/gh_pat
GIT_AUTHOR_NAME=Leviathan Commodore
GIT_AUTHOR_EMAIL=commodore@leviathan.ops
GIT_COMMITTER_NAME=Leviathan Commodore
GIT_COMMITTER_EMAIL=commodore@leviathan.ops

# NOTE: The server-side wager denylist AGENT_WAGER_DENYLIST lives on the
# squid-bot side (leviathan/settings.py + .env), NOT here. After the
# Commodore bot is registered on Telegram, look up its bot user_id via
# getMe and add that int to AGENT_WAGER_DENYLIST in the squid-bot prod env.
