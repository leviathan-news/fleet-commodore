#!/usr/bin/env python3
"""Read-only local inspection CLI for Fleet tracker proposals."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from tracker_proposals import (  # noqa: E402
    MAX_EXPORT_LIMIT,
    MAX_LIST_LIMIT,
    ProposalError,
    export,
    list_proposals,
    local_get,
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Read Fleet's immutable proposal-only tracker inbox",
    )
    parser.add_argument("--state-dir", help="directory containing tracker-proposals.db")
    subparsers = parser.add_subparsers(dest="command", required=True)

    get_parser = subparsers.add_parser("get", help="inspect one proposal without raw request text")
    get_parser.add_argument("proposal_id")

    list_parser = subparsers.add_parser("list", help="list bounded proposal records")
    list_parser.add_argument("--limit", type=int, default=50)
    list_parser.add_argument("--offset", type=int, default=0)

    export_parser = subparsers.add_parser(
        "export", help="export private provenance for an authorized canonical review",
    )
    export_parser.add_argument("--limit", type=int, default=MAX_EXPORT_LIMIT)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.command == "get":
            result = local_get(args.proposal_id, state_dir=args.state_dir)
        elif args.command == "list":
            if not 1 <= args.limit <= MAX_LIST_LIMIT:
                raise ProposalError(f"limit must be from 1 through {MAX_LIST_LIMIT}")
            result = {
                "count": 0,
                "proposals": list_proposals(
                    state_dir=args.state_dir, limit=args.limit, offset=args.offset,
                ),
            }
            result["count"] = len(result["proposals"])
        else:
            result = export(state_dir=args.state_dir, limit=args.limit)
    except (ProposalError, OSError) as exc:
        print(json.dumps({"error": type(exc).__name__, "message": str(exc)}, sort_keys=True))
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
